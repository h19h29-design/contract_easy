# ===== 공통 =====
COMPOSE_PROJECT_NAME=sen-contract-guide
NODE_ENV=production

# 포트 (충돌 시 변경)
WEB_PORT=3000
API_PORT=8787
POSTGRES_PORT=15432
QDRANT_PORT=16333
VALKEY_PORT=16379

# 데이터 루트 (NAS에서는 반드시 공유볼륨 경로 지정, 예: /volume1/sen-contract-data)
SEN_CONTRACT_DATA_ROOT=./data

# ===== 데이터베이스/서비스 =====
DATABASE_URL=
# 예: postgres://sen:CHANGE_ME@postgres:5432/sen_contract  (미설정 시 파일스토어 모드)
QDRANT_URL=http://qdrant:6333
VALKEY_URL=redis://valkey:6379

# ===== 보안 =====
# 필수(운영): openssl rand -hex 32
SESSION_SECRET=change-me-generate-random-32bytes

# ===== 크롤러 =====
CRAWLER_USER_AGENT=sen-contract-guide-crawler/0.1 (+contact: your-email@example.org)
CRAWLER_CONTACT=your-email@example.org
CRAWL_CONCURRENCY=1
CRAWL_DELAY_MS=1200
CRAWL_ALLOW_ATTACHMENTS=false   # robots Disallow 해제는 법무 승인 후에만
CRAWLER_ENGINE=http             # http | playwright

# ===== AI (없어도 키워드 검색·위키·마법사 동작) =====
LLM_PROVIDER=none               # none|openai|openrouter|ollama
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=none         # none|openai|openrouter|ollama
EMBEDDING_API_KEY=

# ===== 배포 게이트 =====
DEPLOY_TO_NAS=false
PUBLIC_DEPLOY=false
