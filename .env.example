# ===== 공통 =====
COMPOSE_PROJECT_NAME=sen-contract-guide
NODE_ENV=production

# 포트 (충돌 시 변경)
PUBLIC_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8787

# 브라우저에서 접근 가능한 API의 공개 HTTPS URL(웹 이미지 빌드 시 고정됨)
NEXT_PUBLIC_API_URL=

# 데이터 루트 (NAS 공유볼륨의 절대 경로를 반드시 지정, 예: /volume1/sen-contract-data)
SEN_CONTRACT_DATA_ROOT=

# ===== 데이터베이스/서비스 =====
# DATABASE_URL의 비밀번호는 URL 인코딩해서 POSTGRES_PASSWORD와 동일하게 설정
POSTGRES_USER=sen
POSTGRES_PASSWORD=
POSTGRES_DB=sen_contract
DATABASE_URL=
# 미설정 시 파일스토어, 설정 시 PostgreSQL 모드(기동 시 마이그레이션 자동 적용)
# 예: postgres://sen:CHANGE_ME@postgres:5432/sen_contract  (미설정 시 파일스토어 모드)
QDRANT_URL=http://qdrant:6333
VALKEY_URL=redis://valkey:6379

# ===== 보안 =====
# 필수(운영): openssl rand -hex 32
SESSION_SECRET=
# 필수(운영): 브라우저 앱의 정확한 Origin (와일드카드 금지)
WEB_ORIGIN=
# 필수(운영, 사용자 테이블이 비어 있을 때만): 안전한 초기 관리자 비밀번호를 비밀 관리 경로로 주입
ADMIN_INITIAL_PASSWORD=

# ===== 크롤러 =====
CRAWLER_USER_AGENT=sen-contract-guide-crawler/0.1 (+contact: your-email@example.org)
CRAWLER_CONTACT=your-email@example.org
CRAWL_CONCURRENCY=1
CRAWL_DELAY_MS=1200
CRAWL_ALLOW_ATTACHMENTS=false   # robots Disallow 해제는 법무 승인 후에만
CRAWLER_ENGINE=http             # http | playwright

# ===== AI (없어도 키워드 검색·위키·마법사 동작) =====
LLM_PROVIDER=none               # none|openai|openrouter|ollama
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=none         # none|openai|openrouter|ollama|hash(hash는 개발/테스트 전용)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=256
VECTOR_STORE=local              # local|qdrant
QDRANT_COLLECTION=sen_contract_chunks

# ===== 배포 게이트 =====
DEPLOY_TO_NAS=false
PUBLIC_DEPLOY=false
